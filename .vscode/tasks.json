{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "${workspaceFolder}/src/body.cpp",
                "${workspaceFolder}/src/plane.cpp",
                "${workspaceFolder}/src/player.cpp",
                "${workspaceFolder}/src/drawing.cpp",
                "${workspaceFolder}/src/collider.cpp",
                "${workspaceFolder}/src/collisions.cpp",
                "${workspaceFolder}/src/bullet.cpp",
                "${workspaceFolder}/src/missile.cpp",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "-I", "${workspaceFolder}/headers",
                "-I /usr/local/include",
                "-L /usr/local/lib",
                "-lraylib"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}